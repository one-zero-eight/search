# Copy to .env on the server and fill in. Never commit .env.

# --- database (docker-compose.prod.yml creates it; the URLs to db/redis are set there) ---
POSTGRES_PASSWORD=
READER_PASSWORD=            # password of the read-only role that runs the model's SQL (created by `catix-db init`)

# --- models: llama.cpp servers (OpenAI-compatible). With the `tunnel` profile use http://tunnel:PORT/v1 ---
LLM_ROUTE=http://gpu-host:8080/v1
EMBEDDINGS_ROUTE=http://gpu-host:8081/v1
RERANKER_ROUTE=http://gpu-host:8082/v1
# GPU_SSH=user@gpu-host     # only for the `tunnel` profile

# --- Telegram bot (@BotFather: a separate bot for the beta, privacy mode off) ---
TG_BOT_TOKEN=
ADMIN_TELEGRAM_IDS=[]       # JSON list; more admins can be added in the bot with /admin

# --- Telegram userbot (an account that reads chats; my.telegram.org -> API development tools) ---
TG_API_ID=
TG_API_HASH=
TG_PROXY=                   # where the network blocks Telegram: socks5://user:pass@host:port or mtproxy://SECRET@host:port
# TG_CHATS / TG_TOPICS are only the starting list: after that the chats are chosen in the bot with /listen

# --- Max bot (optional) ---
MAX_BOT_TOKEN=

# --- InNoHassle (clubs, events, timetables are public; the token finds study groups by Telegram id) ---
INNOHASSLE_SERVICE_TOKEN=   # service token with the `users` scope: finds a user's study group
INNOHASSLE_GROUPS=false     # take study groups from InNoHassle; off: users set theirs with /mygroup

# --- personal calendars at /users/me.ics (Bearer: the user's InNoHassle token); needs public HTTPS in front of port 8090 ---
FEED_PUBLIC_URL=            # https://cal.example.com: the public address of port 8090; /calendar shows the address built on it

# --- Tracing of the agent in Arize Phoenix (optional; unset = off). docker compose up -d phoenix, UI on this address ---
PHOENIX_ENDPOINT=http://localhost:6006

# --- alerts to the admins in Telegram (models, embeddings, reranker, embedding queue); on by default ---
# ALERTS=true
# ALERT_CHECK_SECONDS=60
# ALERT_QUEUE_MAX=500
