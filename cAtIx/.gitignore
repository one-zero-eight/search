# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Secrets
.env

# Telegram session (full account access) and private chat data
data/
raw/*.db*
raw/eduwiki

# Downloaded regulation PDFs and their OCR page images (the extracted text and metadata stay)
raw/regulations/*.pdf
raw/regulations/*.ocr/
raw/regulations/ocr/

# Obsidian keeps its local state (open files, window layout) in the vault folder
wiki/.obsidian/

# The disclosure-section documents are downloaded again by catix-wiki; the list of documents and the decisions about them stay in git
raw/sveden/*
!raw/sveden/index.json
!raw/sveden/triage.json

# The archives of course programmes and their texts are downloaded again by catix-wiki rpd; the list of what was read stays in git
raw/rpd/*
!raw/rpd/index.json
